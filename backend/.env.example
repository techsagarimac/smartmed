# Copy this file to .env and replace the placeholder values.
# Never commit a real .env file.

SMARTMED_ENV=development

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# SQLite path is relative to the backend working directory.
DATABASE_URL=sqlite:///./data/smartmed.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional. Leave empty to use the tesseract binary on PATH.
TESSERACT_CMD=

# Seed a demo account when the database is empty.
SMARTMED_SEED=true
DEMO_EMAIL=demo@smartmed.local
DEMO_PASSWORD=DemoPass123

# Optional caregiver email notifications. If unset, missed-dose alerts are logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
